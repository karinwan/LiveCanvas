{
  "name": "vue_template",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run build-only",
    "build:stage": "cross-env NODE_ENV=stage vite build --mode stage",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@formkit/vue": "^1.6.9",
    "@schedule-x/theme-default": "^2.6.0",
    "@schedule-x/vue": "^2.5.0",
    "@vue-flow/background": "latest",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "latest",
    "axios": "^1.7.7",
    "jspdf": "^3.0.0",
    "konva": "^9.3.20",
    "pinia": "^2.2.6",
    "selenium-webdriver": "^4.30.0",
    "socket.io-client": "^4.8.1",
    "upgrade": "^1.1.0",
    "vue": "^3.5.13",
    "vue-color-kit": "^1.0.6",
    "vue-i18n": "^11.1.1",
    "vue-router": "^4.4.5",
    "vuetify": "^3.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@mdi/font": "^7.4.47",
    "@tsconfig/node18": "^18.2.4",
    "@types/jsdom": "^21.1.7",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^18.19.86",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vitest/coverage-v8": "^3.0.9",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/runtime-core": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.4.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jsdom": "^22.1.0",
    "npm-run-all2": "^6.2.6",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.2.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^4.5.5",
    "vitest": "^3.0.9",
    "vue-tsc": "^1.8.27"
  }
}
